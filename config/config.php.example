// --- URLs base (sin barra final) ---
define('SITE_BASE_URL', 'https://chichalabs.studio');
define('PORTAL_BASE_URL', 'https://chichalabs.studio/portal');
define('ADMIN_BASE_URL', 'https://chichalabs.studio/admin');

// --- n8n (opcional) — dejar vacío para desactivar la notificación ---
define('N8N_PROPOSAL_ACCEPTED_WEBHOOK', '');

// --- Cotizador automático ---
// Secreto compartido con n8n: el workflow "Cotizador — Propuesta" lo manda en
// el header X-Cotizador-Key al pegarle a /api/cotizador-pdf.php. Si queda
// vacío, ese endpoint responde 503 y no genera PDFs (falla cerrado a propósito).
// Generar uno con: php -r "echo bin2hex(random_bytes(24));"
define('COTIZADOR_PDF_SECRET', '');

// --- Meta Conversions API (/api/meta-capi.php) ---
// Espeja del lado del servidor los eventos del pixel, para no perder los que
// bloquean los adblockers. Si el token queda vacío, el endpoint responde 503
// y el sitio sigue funcionando sólo con el pixel del browser (falla cerrado).
//
// El token se saca en Events Manager → el dataset "chichalab" → Configuración
// → Conversions API → "Generar token de acceso". Es un token permanente y da
// permiso de escribir eventos: tratalo como una contraseña.
define('META_PIXEL_ID',  '1703278184288117');
define('META_CAPI_TOKEN', '');

// Sólo para probar: pegá acá el código de Events Manager → Test Events y los
// eventos aparecen ahí sin ensuciar los datos reales. VACIAR en producción.
define('META_TEST_EVENT_CODE', '');

// --- Entorno ---
// 'local' muestra errores detallados; cualquier otro valor los oculta (producción).
define('APP_ENV', 'production');

if (APP_ENV === 'local') {
    ini_set('display_errors', '1');
    error_reporting(E_ALL);
} else {
    ini_set('display_errors', '0');
    error_reporting(E_ALL);
}
